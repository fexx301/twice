{
  "schemaVersion": 1,
  "id": "twice",
  "displayName": "Twice",
  "description": "Show native CRM onboarding once; the agent prepares client batches and code replays approved inputs.",
  "mcp": {
    "serverName": "twice"
  },
  "local": {
    "template": "crm",
    "sourcePath": ".",
    "defaultUrl": "http://127.0.0.1:8851",
    "commands": {
      "install": "pnpm install",
      "dev": "pnpm dev",
      "start": "pnpm start"
    }
  },
  "auth": {
    "mode": "oauth",
    "setup": "Start with Native SQL without an external connection, or connect HubSpot or Salesforce through workspace Connections. CRM never accepts or stores provider credentials."
  },
  "surfaces": [
    {
      "id": "twice-batches",
      "action": "get-twice-workspace",
      "path": "/batches"
    },
    {
      "id": "twice-recipes",
      "action": "get-twice-workspace",
      "path": "/recipes"
    }
  ],
  "skills": [
    {
      "path": ".agents/skills/twice",
      "visibility": "both",
      "exportAs": "twice"
    }
  ],
  "hostAdapters": [
    "codex-plugin",
    "claude-marketplace",
    "vercel-skills",
    "plain-skill",
    "claude-skill",
    "chatgpt-mcp",
    "generic-mcp"
  ]
}
