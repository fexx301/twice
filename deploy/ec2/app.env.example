# Generate fresh production-only secrets into ignored deploy/private/app.env.
DATABASE_URL=postgresql://twice:GENERATED_PASSWORD@db:5432/twice
BETTER_AUTH_SECRET=GENERATE_STABLE_RANDOM_VALUE
A2A_SECRET=GENERATE_STABLE_RANDOM_VALUE
WORKSPACE_SECRETS_ENCRYPTION_KEY=GENERATE_STABLE_RANDOM_VALUE
APP_URL=https://YOUR_HOST.duckdns.org
BETTER_AUTH_URL=https://YOUR_HOST.duckdns.org
AUTH_SIGNUP=invited
ORG_CREATION=closed
AUTO_CREATE_DEFAULT_ORG=0
# No SMTP: owner is created privately before publication; public signup closes.
AUTH_REQUIRE_EMAIL_VERIFICATION=0
# No deployment-wide provider key. Owner configures Personal key after login.
AGENT_NATIVE_DB_POOL_MAX=5
